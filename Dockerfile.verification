# Single-stage build — better-sqlite3's native binding must be
# compiled in the same glibc environment it runs in.
FROM node:22-slim

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/agent/package.json packages/agent/
COPY packages/cli/package.json packages/cli/
COPY apps/registry-server/package.json apps/registry-server/
COPY apps/verification-api/package.json apps/verification-api/

RUN pnpm install --frozen-lockfile --ignore-scripts && \
    cd node_modules/.pnpm/better-sqlite3@13.0.1/node_modules/better-sqlite3 && \
    rm -rf prebuilds build && \
    npx --yes node-gyp rebuild

COPY packages/ packages/
COPY apps/ apps/

RUN pnpm build

ENV NODE_ENV=production

EXPOSE 4001
RUN mkdir -p /data

CMD ["node", "apps/verification-api/dist/index.js", "--port=4001", "--db=/data/platform.db"]
