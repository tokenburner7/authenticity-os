# ── Build stage ─────────────────────────────────────────
FROM node:22-slim AS builder

# Install build tools for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

# Pin pnpm to match the host version
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

WORKDIR /app

# Copy workspace root files for dependency resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./

# Copy all package.json files for hoisted install
COPY packages/protocol/package.json packages/protocol/
COPY packages/agent/package.json packages/agent/
COPY packages/cli/package.json packages/cli/
COPY apps/registry-server/package.json apps/registry-server/
COPY apps/verification-api/package.json apps/verification-api/

# Install dependencies — --ignore-scripts skips native builds to avoid
# pnpm v11's hard error on unapproved build scripts, then we rebuild
# the native modules explicitly.
RUN pnpm install --frozen-lockfile --ignore-scripts && \
    pnpm rebuild better-sqlite3

# Copy source and build
COPY packages/ packages/
COPY apps/ apps/

RUN pnpm build

# ── Runtime stage ───────────────────────────────────────
# Copy the entire built workspace from the builder. This avoids a second
# install/rebuild in the runtime stage, trading image size for reliability.
FROM node:22-slim AS runtime

WORKDIR /app

COPY --from=builder /app/ .

ENV NODE_ENV=production

# Registry server
EXPOSE 4000
CMD ["node", "apps/registry-server/dist/index.js", "--port=4000"]
