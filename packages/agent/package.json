{
  "name": "@auth/agent",
  "version": "0.0.1",
  "description": "Personal AI agent platform with identity wallet, social delegation, and agent-to-agent communication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
